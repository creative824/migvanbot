# ── חובה ─────────────────────────────────────────────
# הטוקן שמקבלים מ-@BotFather בטלגרם
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── אופציונלי ────────────────────────────────────────
# פרטי מגיש ההצעה שמופיעים במסמך
PRESENTER_NAME=עודד אירמייב
PRESENTER_PHONE=052-8281005

# הגבלת גישה: מזהי משתמשי טלגרם המורשים, מופרדים בפסיק.
# השאר ריק כדי לאפשר לכולם. כדי לגלות מזהה – שלחו הודעה לבוט @userinfobot
ALLOWED_USER_IDS=

# נתיב ידני ל-Chromium (לרוב לא נדרש)
PLAYWRIGHT_EXECUTABLE=

# קישור חתימה ללקוח (וואטסאפ). 0 = כבוי (הבוט שולח רק PDF).
# הפעלה: 1  — ואז צריך גם PUBLIC_BASE_URL, או להריץ דרך run_with_link.bat
WEB_ENABLED=0
PUBLIC_BASE_URL=
WEB_PORT=8080

# מייל אוטומטי כשלקוח חותם (Resend - https://resend.com, חינם)
# API Keys באתר -> Create API Key -> להעתיק לכאן
RESEND_API_KEY=
NOTIFY_EMAIL=
EMAIL_FROM=onboarding@resend.dev
